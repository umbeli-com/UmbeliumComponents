{
  "name": "umbeli-components",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for reusable Umbeli SaaS components",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint packages/*/src",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "vendor:sync": "node scripts/sync-vendor.mjs",
    "vendor:check": "node scripts/sync-vendor.mjs --check",
    "vendor:list": "node scripts/vendor-list.mjs"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
